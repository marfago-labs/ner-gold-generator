{
  "seed": 42,
  "num_documents": 50,
  "engine": "llm",
  "document_type": "scientific_abstract",
  "document_profiles_dir": "document_profiles",
  "text_length": { "min_chars": 1500, "max_chars": 2000 },
  "entities_per_document": { "distribution": "fixed", "fixed": 6 },
  "label_weights": {
    "model": 0.2,
    "dataset": 0.15,
    "metric": 0.15,
    "organization": 0.1,
    "date": 0.1,
    "number": 0.1,
    "year": 0.1,
    "method": 0.1
  },
  "llm": {
    "model": "openai/gpt-oss-120b:free",
    "agent_mode": "per_doc",
    "max_attempts": 3,
    "provider_max_attempts": 2,
    "validation_max_attempts": 10,
    "temperature": 0.4,
    "timeout_seconds": 90,
    "request_delay_seconds": 2,
    "parallelism": 50,
    "prompt_file": "prompts/synthetic_llm_system_prompt.txt",
    "user_prompt_file": "prompts/synthetic_llm_user_prompt.txt",
    "feedback_prompt_file": "prompts/synthetic_llm_feedback_prompt.txt"
  }
}
