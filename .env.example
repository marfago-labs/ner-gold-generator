# OpenRouter (LLM mode: build-arxiv-gold --mode llm)
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# LLM_GOLD_MODEL=openai/gpt-4o-mini
# LLM_GOLD_SAMPLES=3
# LLM_GOLD_MIN_VOTES=0
# LLM_GOLD_TEMPERATURE=0.4
# MOCK_LLM=false

# Optional input path overrides (defaults assume marfago-labs sibling repos)
# ARXIV_RAW_DIR=../text-compressor/data/raw/arxiv
# ARXIV_INPUT_DIR=../text-compressor/data/raw/arxiv
# YOUTUBE_INPUT_DIR=../text-compressor/data/raw/youtube
# FOLDER_INPUT_DIR=./my-corpus
